# D&D AI DM — 环境变量示例
#
# 复制为 .env（只在开发/自托管时使用；桌面版由应用内首次设置窗口管理，
# 配置保存在 electron-store，不需要 .env）。

# ---- AI 提供商 ----
# 必填：OpenAI 兼容接口的 API Key。默认走 OpenRouter。
# 注册 → https://openrouter.ai/keys
AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：Base URL（OpenAI 兼容）。默认 https://openrouter.ai/api/v1
# 若自建网关 / Azure OpenAI / DeepSeek 官方 API 等，改这里。
# AI_BASE_URL=https://openrouter.ai/api/v1
#
# 用 DeepSeek 官方 API（比 OpenRouter 便宜，中文叙事质量同级）：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_CHAT_MODELS=deepseek-chat,deepseek-reasoner
# AI_MODULE_MODELS=deepseek-chat
# 注册 → https://platform.deepseek.com/api_keys

# 可选：DM 叙事时依次尝试的模型列表（逗号分隔，第一个失败用第二个……）
# AI_CHAT_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,anthropic/claude-3.5-sonnet,google/gemini-2.0-flash-001

# 可选：模组生成/解析用的模型
# AI_MODULE_MODELS=deepseek/deepseek-v4-pro,google/gemini-2.0-flash-001,anthropic/claude-3.5-sonnet

# ---- 本地服务 ----
# Express 端口。桌面版用 0（OS 随机分配），自托管建议固定一个端口。
PORT=3000
